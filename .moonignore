# Publishing policy mirrors .gitignore and includes the pinned toolchain.
# MoonBit build artifacts
_build/
*.wasm
*.wat

# Dependencies (managed by moon)
.mooncakes/

# Local secrets
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Test outputs
/tmp/
*.docx
*.pdf

# Python development checks
__pycache__/
*.pyc

# Required by the reproducible source-package instructions
!/.moonbit-version
